","value":" 的阶，记做 "},{"type":"inlineMath","value":"\\delta_N(X)=r"},{"type":"text","value":"."}]},{"type":"paragraph","children":[{"type":"text","value":"所以，原根的定义也可以描述为："},{"type":"inlineMath","value":"X"},{"type":"text","value":" 是模 "},{"type":"inlineMath","value":"N"},{"type":"text","value":" 的一个原根的充要条件为 "},{"type":"inlineMath","value":"\\varphi(N)=\\delta_N(X)"},{"type":"text","value":"."}]}]}]},{"type":"heading","depth":2,"children":[{"type":"text","value":"如何求原根"}],"identifier":"heading-如何求原根"},{"type":"list","ordered":false,"marker":42,"spread":true,"children":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"【性质1】："},{"type":"inlineMath","value":"r \\mid \\varphi(N)"}]},{"type":"blockquote","children":[{"type":"paragraph","children":[{"type":"text","value":"由定义可知，"},{"type":"inlineMath","value":"\\varphi(N) \\geqslant \\delta_N(X)=r"},{"type":"text","value":"；不妨设 "},{"type":"inlineMath","value":"\\varphi(N)=k\\cdot r+t"},{"type":"text","value":"，其中 "},{"type":"inlineMath","value":"0\\leqslant t < r"},{"type":"text","value":"."},{"type":"break"},{"type":"text","value":"\n因为 "},{"type":"inlineMath","value":"X^r\\equiv 1\\mod N"},{"type":"text","value":"，所以有\n"},{"type":"inlineMath","value":"X^{\\varphi(N)} \\equiv X^{k\\cdot r+t} \\equiv X^t \\equiv 1 \\mod N"},{"type":"text","value":"."},{"type":"break"},{"type":"text","value":"\n由于 "},{"type":"inlineMath","value":"\\delta_N(X)=r"},{"type":"text","value":"；所以，必有 "},{"type":"inlineMath","value":"t=0"},{"type":"text","value":"."},{"type":"break"},{"type":"text","value":"\n故 "},{"type":"inlineMath","value":"r \\mid \\varphi(N)"},{"type":"text","value":"."}]}]}]}]},{"type":"heading","depth":3,"children":[{"type":"text","value":"算法原理"}],"identifier":"heading-算法原理"},{"type":"paragraph","children":[{"type":"text","value":"枚举 "},{"type":"inlineMath","value":"X"},{"type":"text","value":" 是否 "},{"type":"inlineMath","value":"N"},{"type":"text","value":" 的原根即可。"}]},{"type":"paragraph","children":[{"type":"text","value":"通过【性质 1】，我们可以简单地通过检查所有的\n"},{"type":"inlineMath","value":"\\displaystyle \\left\\lbrace  n \\Big| 1 < n < \\varphi(N) \\;\\text{且}\\; n\\mid \\varphi(N) \\right\\rbrace"},{"type":"text","value":"\n是否都满足 "},{"type":"inlineMath","value":"X^n\\not\\equiv 1 \\mod N"},{"type":"text","value":" 来判断 "},{"type":"inlineMath","value":"X"},{"type":"text","value":" 是否为模 "},{"type":"inlineMath","value":"N"},{"type":"text","value":" 的一个原根。进一步地，如果 "},{"type":"inlineMath","value":"\\varphi(N)=p_1^{k_1}p_2^{k_2}\\cdots p_s^{k_s}"},{"type":"text","value":"，我们仅需检查\n"},{"type":"inlineMath","value":"\\displaystyle n=\\frac{\\varphi(N)}{p_i},1\\leqslant i\\leqslant s"},{"type":"text","value":" 就够了。原因很简单，如果 "},{"type":"inlineMath","value":"\\forall i, \\; 1\\leqslant i\\leqslant s"},{"type":"text","value":" 都有\n"},{"type":"inlineMath","value":"0\\leqslant a_i\\leqslant k_i"},{"type":"text","value":" 成立，且 "},{"type":"inlineMath","value":"\\exists j ,\\; 1\\leqslant j\\leqslant s"},{"type":"text","value":" 使得 "},{"type":"inlineMath","value":"0\\leqslant a_j < k_j"},{"type":"text","value":" 成立；则必有 "},{"type":"inlineMath","value":"\\displaystyle p_1^{a_1}p_2^{a_2}\\cdots p_s^{a_s} \\mid \\frac{\\varphi(N)}{p_j}"},{"type":"text","value":"\n成立。所以，若 "},{"type":"inlineMath","value":"\\displaystyle X^{p_1^{a_1}p_2^{a_2}\\cdots p_s^{a_s}}\\equiv 1 \\mod N"},{"type":"text","value":"，那么 "},{"type":"inlineMath","value":"\\displaystyle X^{\\frac{\\varphi(N)}{p_j}}\\equiv 1 \\mod N"},{"type":"text","value":" 也会成立。"}]},{"type":"paragraph","children":[{"type":"text","value":"综上，对于每个数 "},{"type":"inlineMath","value":"g"},{"type":"text","value":"，最多检查 "},{"type":"inlineMath","value":"\\varphi(N)"},{"type":"text","value":" 的素因子个数次即可判断其是否为 "},{"type":"inlineMath","value":"N"},{"type":"text","value":"\n的一个原根。"}]},{"type":"heading","depth":3,"children":[{"type":"text","value":"程序实现"}],"identifier":"heading-程序实现"},{"type":"code","lang":"cpp","meta":"title=\"primitive.root.cpp\" linenos","value":"void calcFactor(int N, vector<int>& fac) {\n  int sm = ceil(sqrt(1.0 * N));\n  for (int i = 2; i <= sm; ++i) {\n    if (N%i == 0) {\n      fac.push_back(i);\n      while (N%i == 0) N /= i;\n    }\n  }\n  if (N > 1) fac.push_back(N);\n}\n\nint calcPrimitiveRoot(int N) {\n  vector<int> fac;\n\n  // phi(N) 返回 N 的欧拉函数值，实现略\n  int PHI_N = phi(N);\n  calcFactor(PHI_N, fac);\n\n  for (int i = 0; i < fac.size(); ++i) fac[i] = PHI_N / fac[i];\n  for (int g = 2; ; ++g) {\n    bool flag = true;\n    for (int i = 0; i < fac.size(); ++i) {\n      // powerMod 返回 $g^{fac[i]} \\mod N$，实现略\n      if (powerMod(g, fac[i], N) == 1) {\n        flag = false;\n        break;\n      }\n    }\n    if (flag) return g;\n  }    \n}\n"},{"type":"heading","depth":2,"children":[{"type":"text","value":"小记"}],"identifier":"heading-小记"},{"type":"list","ordered":false,"marker":42,"spread":true,"children":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"哪些数有原根"}]},{"type":"paragraph","children":[{"type":"inlineMath","value":"N"},{"type":"text","value":" 有原根的充要条件是 "},{"type":"inlineMath","value":"N=2,4,p^k,2\\times p^k"},{"type":"text","value":"。其中，"},{"type":"inlineMath","value":"p"},{"type":"text","value":" 为奇素数，"},{"type":"inlineMath","value":"k"},{"type":"text","value":" 为任意正整数。"}]}]}]}]},"frontmatter":{"title":"数论基础之原根","createdAt":"2016-05-16T04:11:55.000Z","updatedAt":"2021-11-03T05:57:24.000Z","tags":["math","数论","原根"]},"definitionMap":{},"footnoteDefinitionMap":{},"ecmaImports":[],"images":[],"toc":{"children":[{"depth":2,"identifier":"heading-什么是原根","contents":[{"type":"text","value":"什么是原根"}],"children":[]},{"depth":2,"identifier":"heading-如何求原根","contents":[{"type":"text","value":"如何求原根"}],"children":[{"depth":3,"identifier":"heading-算法原理","contents":[{"type":"text","value":"算法原理"}],"children":[]},{"depth":3,"identifier":"heading-程序实现","contents":[{"type":"text","value":"程序实现"}],"children":[]}]},{"depth":2,"identifier":"heading-小记",