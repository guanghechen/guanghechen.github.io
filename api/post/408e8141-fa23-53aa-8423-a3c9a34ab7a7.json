{"title":{"type":"paragraph","children":[{"type":"text","value":"在 excel 中启用正则表达式"}]},"ast":{"type":"root","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"Usage"}],"identifier":"heading-usage"},{"type":"list","ordered":false,"marker":42,"spread":true,"children":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"启用 VBA ("},{"type":"inlineCode","value":"*.xlsm"},{"type":"text","value":" 文件中有效)"}]},{"type":"list","ordered":false,"marker":45,"spread":false,"children":[{"type":"listItem","children":[{"type":"text","value":"在 Excel 中："},{"type":"inlineCode","value":"文件"},{"type":"text","value":" --> "},{"type":"inlineCode","value":"选项"},{"type":"text","value":" --> "},{"type":"inlineCode","value":"自定义功能区"},{"type":"text","value":" 勾选 "},{"type":"inlineCode","value":"开发工具"}]}]},{"type":"paragraph","children":[{"type":"imageReference","identifier":"excel-enable-vba.png","label":"excel-enable-vba.png","referenceType":"collapsed","alt":"excel-enable-vba.png"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"启用 "},{"type":"emphasis","children":[{"type":"text","value":"Microsoft VBScript Regular Expressions5.5"}]},{"type":"text","value":" 模块"}]},{"type":"list","ordered":false,"marker":45,"spread":false,"children":[{"type":"listItem","children":[{"type":"text","value":"打开 "},{"type":"emphasis","children":[{"type":"text","value":"Visual Basic"}]},{"type":"text","value":" 编辑器："},{"type":"inlineCode","value":"开发工具"},{"type":"text","value":" --> "},{"type":"inlineCode","value":"Visual Basic"}]},{"type":"listItem","children":[{"type":"text","value":"在 "},{"type":"emphasis","children":[{"type":"text","value":"Visual Basic"}]},{"type":"text","value":" 编辑器中打开："},{"type":"inlineCode","value":"工具"},{"type":"text","value":" --> "},{"type":"inlineCode","value":"引用"}]},{"type":"listItem","children":[{"type":"text","value":"在弹出的对话框中勾选 "},{"type":"inlineCode","value":"Microsoft VBScript Regular Expressions 5.5"}]}]},{"type":"paragraph","children":[{"type":"imageReference","identifier":"excel-enable-vba-regex.png","label":"excel-enable-vba-regex.png","referenceType":"collapsed","alt":"excel-enable-vba-regex.png"}]}]}]},{"type":"html","value":"<!-- more -->\n"},{"type":"list","ordered":false,"marker":42,"spread":true,"children":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"导入正则表达式的 VBA 脚本"}]},{"type":"list","ordered":false,"marker":45,"spread":true,"children":[{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"在 "},{"type":"emphasis","children":[{"type":"text","value":"Visual Basic"}]},{"type":"text","value":" 编辑器中打开 "},{"type":"inlineCode","value":"插入模块"},{"type":"text","value":"（文件选项卡的正下方） --> "},{"type":"inlineCode","value":"模块"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"在弹出的对话框中粘贴如下脚本："}]},{"type":"code","lang":"visual-basic","meta":"title=\"regex.vb\" maxlines=12 linenos","value":"Function regex(strInput As String, matchPattern As String, Optional ByVal outputPattern As String = \"$0\") As Variant\n    Dim inputRegexObj As New VBScript_RegExp_55.RegExp, outputRegexObj As New VBScript_RegExp_55.RegExp, outReplaceRegexObj As New VBScript_RegExp_55.RegExp\n    Dim inputMatches As Object, replaceMatches As Object, replaceMatch As Object\n    Dim replaceNumber As Integer\n\n    With inputRegexObj\n        .Global = True\n        .MultiLine = True\n        .IgnoreCase = False\n        .Pattern = matchPattern\n    End With\n    With outputRegexObj\n        .Global = True\n        .MultiLine = True\n        .IgnoreCase = False\n        .Pattern = \"\\$(\\d+)\"\n    End With\n    With outReplaceRegexObj\n        .Global = True\n        .MultiLine = True\n        .IgnoreCase = False\n    End With\n\n    Set inputMatches = inputRegexObj.Execute(strInput)\n    If inputMatches.Count = 0 Then\n        regex = False\n    Else\n        Set replaceMatches = outputRegexObj.Execute(outputPattern)\n        For Each replaceMatch In replaceMatches\n            replaceNumber = replaceMatch.SubMatches(0)\n            outReplaceRegexObj.Pattern = \"\\$\" & replaceNumber\n\n            If replaceNumber = 0 Then\n                outputPattern = outReplaceRegexObj.Replace(outputPattern, inputMatches(0).Value)\n            Else\n                If replaceNumber > inputMatches(0).SubMatches.Count Then\n                    'regex = \"A to high $ tag found. Largest allowed is $\" & inputMatches(0).SubMatches.Count & \".\"\n                    regex = CVErr(xlErrValue)\n                    Exit Function\n                Else\n                    outputPattern = outReplaceRegexObj.Replace(outputPattern, inputMatches(0).SubMatches(replaceNumber - 1))\n                End If\n            End If\n        Next\n        regex = outputPattern\n    End If\nEnd Function\n"}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"保存，然后关闭各种对话框"}]}]}]},{"type":"paragraph","children":[{"type":"imageReference","identifier":"excel-import-regex-script.png","label":"excel-import-regex-script.png","referenceType":"collapsed","alt":"excel-import-regex-script.png"}]}]},{"type":"listItem","children":[{"type":"paragraph","children":[{"type":"text","value":"使用"}]},{"type":"paragraph","children":[{"type":"text","value":"直接选中单元格，然后在上面输入公式即可，语法如下："}]},{"type":"code","lang":"javascript","meta":null,"value":"regex(<original_string>, <regex_pattern>, <replace_string>)\n"},{"type":"list","ordered":false,"marker":45,"spread":false,"children":[{"type":"listItem","children":[{"type":"inlineCode","value":"<original_string>"},{"type":"text","value":" 原始字符串，可以使用 Excel 中的单元格引用，如 "},{"type":"inlineCode","value":"E4"}]},{"type":"listItem","children":[{"type":"inlineCode","value":"<regex_pattern>"},{"type":"text","value":" 正则表达式，无需转义，如："},{"type":"inlineCode","value":"\"(\\d+)\\.(\\d+)\\.(\\d+)\""}]},{"type":"listItem","children":[{"type":"inlineCode","value":"<replace_string>"},{"type":"text","value":" 替换的字符串，如："},{"type":"inlineCode","value":"\"$1年$2月$3日\""}]}]},{"type":"paragraph","children":[{"type":"imageReference","identifier":"excel-regex-demo1.png","label":"excel-regex-demo1.png","referenceType":"collapsed","alt":"excel-regex-demo1.png"}]}]}]},{"type":"heading","depth":2,"children":[{"type":"text","value":"Related"}],"identifier":"heading-related"},{"type":"list","ordered":false,"marker":42,"spread":false,"children":[{"type":"listItem","children":[{"type":"link","url":"https://stackoverflow.com/a/28176749/14797950","children":[{"type":"text","value":"How to use Regular Expressions (Regex) in Microsoft Excel both in-cell and loops"}]}]}]}]},"frontmatter":{"createdAt":"2021-03-29T21:23:17.183Z","updatedAt":"2021-11-03T05:57:24.000Z","title":"在 excel 中启用正则表达式","description":"Enable Regex in Excel","tags":["excel","tools"]},"definitionMap":{"excel-enable-vba.png":{"type":"definition","identifier":"excel-enable-vba.png","label":"excel-enable-vba.png","url":"/asset/post/img/ec213631-c1ff-5cdc-9a76-bd5c3ab6bcf6.png?width=1039&height=851"},"excel-enable-vba-regex.png":{"type":"definition","identifier":"excel-enable-vba-regex.png","label":"excel-enable-vba-regex.png","url":"/asset/post/img/cde4bd5a-9c14-5e20-b5a2-e608887602d0.png?width=1159&height=522"},"excel-import-regex-script.png":{"type":"definition","identifier":"excel-import-regex-script.png","label":"excel-import-regex-script.png","url":"/asset/post/img/eb5441d6-2d88-5e00-aad9-555b4b274421.png?width=752&height=470"},"excel-regex-demo1.png":{"type":"definition","identifier":"excel-regex-demo1.png","label":"excel-regex-demo1.png","url":"/asset/post/img/437c2313-9d5b-5339-8b14-bacb5cd78864.png?width=532&height=233"}},"footnoteDefinitionMap":{},"ecmaImports":[],"images":[{"alt":"excel-enable-vba.png","src":"/asset/post/img/ec213631-c1ff-5cdc-9a76-bd5c3ab6bcf6.png?width=1039&height=851"},{"alt":"excel-enable-vba-regex.png","src":"